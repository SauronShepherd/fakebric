{
  "$defs": {
    "Column": {
      "additionalProperties": false,
      "properties": {
        "name": {"minLength": 1, "title": "Name", "type": "string"},
        "nullable": {"default": true, "title": "Nullable", "type": "boolean"},
        "sourceName": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Sourcename"},
        "type": {"$ref": "#/$defs/DataType"}
      },
      "required": ["name", "type"],
      "title": "Column",
      "type": "object"
    },
    "DataSource": {
      "additionalProperties": false,
      "properties": {
        "credentialRef": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Credentialref"},
        "options": {"additionalProperties": true, "title": "Options", "type": "object"},
        "path": {"minLength": 1, "title": "Path", "type": "string"},
        "type": {"$ref": "#/$defs/DataSourceType"}
      },
      "required": ["type", "path"],
      "title": "DataSource",
      "type": "object"
    },
    "DataSourceType": {"enum": ["parquet", "csv", "jsonl", "fakebrick"], "title": "DataSourceType", "type": "string"},
    "DataType": {"enum": ["string", "integer", "decimal", "boolean", "date", "datetime", "binary"], "title": "DataType", "type": "string"},
    "LifecycleState": {"enum": ["Draft", "Published", "Archived"], "title": "LifecycleState", "type": "string"},
    "Measure": {
      "additionalProperties": false,
      "properties": {
        "expression": {"minLength": 1, "title": "Expression", "type": "string"},
        "name": {"minLength": 1, "title": "Name", "type": "string"}
      },
      "required": ["name", "expression"],
      "title": "Measure",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "properties": {
        "columns": {"items": {"$ref": "#/$defs/Column"}, "title": "Columns", "type": "array"},
        "measures": {"items": {"$ref": "#/$defs/Measure"}, "title": "Measures", "type": "array"},
        "name": {"minLength": 1, "title": "Name", "type": "string"},
        "source": {"$ref": "#/$defs/DataSource"}
      },
      "required": ["name", "source"],
      "title": "Table",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "createdAt": {"format": "date-time", "title": "Createdat", "type": "string"},
    "description": {"default": "", "title": "Description", "type": "string"},
    "id": {"minLength": 1, "title": "Id", "type": "string"},
    "name": {"minLength": 1, "title": "Name", "type": "string"},
    "relationships": {"items": {"additionalProperties": true, "type": "object"}, "title": "Relationships", "type": "array"},
    "revision": {"default": 1, "minimum": 1, "title": "Revision", "type": "integer"},
    "state": {"$ref": "#/$defs/LifecycleState", "default": "Draft"},
    "tables": {"items": {"$ref": "#/$defs/Table"}, "title": "Tables", "type": "array"},
    "updatedAt": {"format": "date-time", "title": "Updatedat", "type": "string"},
    "version": {"default": "1.0", "title": "Version", "type": "string"}
  },
  "required": ["id", "name"],
  "title": "SemanticModel",
  "type": "object"
}
